:root {
  --ink: #f4ece2;
  --muted: #c4b8aa;
  --gold: #d7b56d;
  --paper: rgba(18, 14, 12, 0.72);
  --line: rgba(244, 236, 226, 0.14);
  --accent: #8f3b24;
  --best: #3d7a58;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  min-height: 100%;
  background: #0c0908;
  color: var(--ink);
  font-family: Outfit, system-ui, sans-serif;
}

#scene {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.vignette {
  position: fixed;
  inset: 0;
  pointer-events: none;
  background: radial-gradient(ellipse at 70% 40%, transparent 20%, rgba(8, 5, 4, 0.72) 80%);
}

.topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  padding: 1.25rem 1.75rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-size: 0.7rem;
  color: var(--muted);
}

.mark {
  margin: 0;
  color: var(--gold);
}

.stage-label {
  margin: 0;
}

main {
  position: relative;
  z-index: 2;
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 5rem 1.25rem 2.5rem;
}

.panel {
  width: min(920px, 100%);
  background: var(--paper);
  border: 1px solid var(--line);
  backdrop-filter: blur(16px);
  padding: 1.75rem;
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
}

.panel.hidden,
[hidden] {
  display: none !important;
}

.kicker {
  margin: 0 0 0.4rem;
  color: var(--gold);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-size: 0.68rem;
}

h1 {
  margin: 0 0 0.6rem;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: clamp(2rem, 5vw, 3.4rem);
  font-weight: 500;
  line-height: 1.05;
}

.lede {
  margin: 0 0 1.4rem;
  color: var(--muted);
  max-width: 42rem;
}

form,
label {
  display: grid;
  gap: 0.4rem;
}

form {
  gap: 0.9rem;
}

label {
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
}

input {
  width: 100%;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.04);
  color: var(--ink);
  padding: 0.75rem 0.8rem;
  font: inherit;
  text-transform: none;
  letter-spacing: 0;
}

input:focus {
  outline: 1px solid var(--gold);
}

button {
  border: 0;
  background: var(--gold);
  color: #1a140f;
  font: inherit;
  font-weight: 600;
  padding: 0.85rem 1.1rem;
  cursor: pointer;
}

button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

button.ghost {
  background: transparent;
  color: var(--ink);
  border: 1px solid var(--line);
}

.form-error {
  margin: 0;
  color: #e9a39a;
  font-size: 0.9rem;
}

.deal-grid {
  display: grid;
  gap: 0.9rem;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
}

.deal-card {
  text-align: left;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--line);
  color: var(--ink);
  padding: 1rem;
  display: grid;
  gap: 0.35rem;
}

.deal-card.selected {
  border-color: var(--gold);
  box-shadow: inset 0 0 0 1px var(--gold);
}

.deal-card.best {
  border-color: #7dba96;
}

.deal-card .badge {
  width: fit-content;
  font-size: 0.65rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #b7e0c7;
}

.deal-card h2 {
  margin: 0;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 1.6rem;
  font-weight: 500;
}

.deal-card .price {
  color: var(--gold);
  font-size: 1.15rem;
}

.deal-card p {
  margin: 0;
  color: var(--muted);
  font-size: 0.92rem;
}

.deal-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.7rem;
  margin-top: 1.1rem;
}

.checkout-layout {
  display: grid;
  gap: 1.1rem;
}

@media (min-width: 760px) {
  .checkout-layout {
    grid-template-columns: 0.9fr 1.1fr;
    align-items: start;
  }
}

.summary {
  border: 1px solid var(--line);
  padding: 1rem;
  background: rgba(255, 255, 255, 0.03);
}

.summary h2 {
  margin: 0 0 0.5rem;
  font-size: 1.1rem;
}

.summary p,
.hint {
  color: var(--muted);
  margin: 0.25rem 0;
}

.row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.7rem;
}
